{
	"name": "@barbajoe/css-lib",
	"version": "0.3.0",
	"license": "MIT",
	"author": "Barbacoa08",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Barbacoa08/barbajoe.git",
		"directory": "src/packages/css-lib"
	},
	"homepage": "https://lib-staging.barbajoe.tech/",
	"style": "./dist/barbajoe.css",
	"exports": {
		".": "./dist/barbajoe.css",
		"./dist/barbajoe.css": "./dist/barbajoe.css"
	},
	"sideEffects": ["./dist/barbajoe.css", "./specimen/specimen.js"],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"files": ["dist/barbajoe.css"],
	"scripts": {
		"all": "pnpm i && pnpm clean && pnpm style-check && pnpm build",
		"dev": "parcel serve specimen/index.html specimen/headers.html specimen/layout-header.html specimen/layout-footer.html specimen/layout-minimal.html --open",
		"clean": "rm -rf dist",
		"lint": "biome ci ./lib ./specimen --error-on-warnings",
		"format": "biome format --write ./lib",
		"style-check": "biome check --write ./lib",
		"build": "mkdir -p dist && pnpm build:prod",
		"build:prod": "lightningcss --nesting --minify --bundle --targets '>= 0.25%' lib/barbajoe.css -o dist/barbajoe.css",
		"build:specimen": "parcel build specimen/index.html specimen/headers.html specimen/layout-header.html specimen/layout-footer.html specimen/layout-minimal.html --dist-dir .output/specimen --no-cache"
	},
	"devDependencies": {
		"lightningcss-cli": "1.33.0",
		"parcel": "2.16.4"
	}
}
