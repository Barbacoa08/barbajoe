{
  extends: [
    "config:base",
    "schedule:weekly", // each monday
    "group:allNonMajor", // batch non-majors into one PR
    ":semanticCommits", // nicer commit messages
  ],
  assignees: ["Barbacoa08"],
  reviewers: ["Barbacoa08"],
  labels: ["dependencies"],
  rangeStrategy: "pin",
  // Archived workspaces contain documentation only. Re-enable their paths if
  // an application or component library is deliberately rebuilt.
  ignorePaths: [
    "src/apps/**",
    "src/packages/react-lib/**",
    "src/packages/svelte-lib/**",
  ],
}
