{
	"name": "barbajoe",
	"private": true,
	"description": "Development workspace for the @barbajoe/css-lib CSS package.",
	"author": "Joe S",
	"license": "MIT",
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": "v24.21.0",
		"pnpm": "12.6.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Barbacoa08/barbajoe/"
	},
	"keywords": [
		"css",
		"design-system",
		"monorepo",
		"workspace",
		"library"
	],
	"scripts": {
		"build": "pnpm --filter @barbajoe/css-lib build",
		"build:specimen": "pnpm --filter @barbajoe/css-lib build:specimen",
		"check": "pnpm lint && pnpm build",
		"css-lib": "pnpm --filter @barbajoe/css-lib",
		"lint": "biome ci src/packages/css-lib/lib src/packages/css-lib/specimen .github/scripts tests/browser playwright.config.mjs --error-on-warnings",
		"test:release": "node --test .github/scripts/*.test.mjs",
		"test:browser": "playwright test",
		"test:browser:report": "playwright show-report"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@playwright/test": "1.63.0",
		"http-server": "14.1.1"
	}
}
